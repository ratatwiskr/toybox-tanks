{
  "name": "toybox-tanks",
  "version": "1.0.0",
  "description": "A small browser-based couch co-op tank game.",
  "private": true,
  "type": "module",
  "license": "ISC",
  "author": "",
  "keywords": [],
  "volta": {
    "node": "24.22.2"
  },
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "preview": "vite preview",
    "capture:visual:baseline": "node tests/visual/development-cli.ts capture",
    "test:visual:compare": "node tests/visual/development-cli.ts compare",
    "test:visual:report": "node tests/visual/development-cli.ts report",
    "visual:capture": "npm run capture:visual:baseline --",
    "visual:compare": "npm run test:visual:compare --",
    "visual:report": "npm run test:visual:report --",
    "visual:candidates": "npm run test:visual:candidates --",
    "verify:fast": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run test:e2e && npm run test:visual && npm run test:release",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.sim.json && tsc -p tsconfig.tooling.json && tsc -p tsconfig.unit.json && tsc -p tsconfig.e2e.json && tsc -p tsconfig.fixtures.json",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:visual": "npm run test:visual:candidates --",
    "test:visual:candidates": "playwright test --project=visual",
    "test:browsers": "npm run build && playwright test --config playwright.release.config.ts tests/release/hosted.spec.ts",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "test:release": "npm run build && npm run build:single && playwright test --config playwright.release.config.ts --project=chromium",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "build:test": "vite build --mode test",
    "capture:visual": "npm run capture:visual:baseline --",
    "compare:visual": "npm run test:visual:compare --",
    "report:visual": "npm run test:visual:report --",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{css,html,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0"
  }
}
